{
  "name": "devdock",
  "version": "0.3.0",
  "private": true,
  "description": "Offline desktop controls for local development projects.",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "setup:runtime": "node scripts/setup-runtime.mjs",
    "setup:sharing": "node scripts/setup-sharing.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && node scripts/build-main.mjs && vite build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:desktop:dev": "node scripts/desktop-smoke.mjs --dev",
    "test:sharing:live": "node scripts/sharing-smoke.mjs",
    "montage": "npm --prefix project-demo run montage",
    "montage:record": "node project-demo/scripts/record.mjs",
    "montage:process": "node project-demo/scripts/process.mjs",
    "montage:audio": "node project-demo/scripts/audio.mjs",
    "montage:render": "node project-demo/scripts/render.mjs",
    "montage:finalize": "node project-demo/scripts/finalize.mjs",
    "montage:qa": "node project-demo/scripts/qa.mjs",
    "montage:clean": "node project-demo/scripts/clean.mjs",
    "montage:check": "node node_modules/typescript/bin/tsc --project project-demo/tsconfig.json --noEmit",
    "test:settings": "node scripts/settings-smoke.mjs",
    "test:projects": "node scripts/projects-smoke.mjs",
    "test:activity": "node scripts/external-activity-smoke.mjs",
    "test:external-servers": "node scripts/external-servers-smoke.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
